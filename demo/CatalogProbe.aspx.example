<%@ Page Language="C#" %>
<%@ Import Namespace="System.Data.SqlClient" %>
<script runat="server">
protected void Page_Load(object sender, EventArgs e) {
    CConector adapter = new CConector();
    using (SqlDataReader rows = adapter.Query("SELECT nombre FROM dbo.departamentos WHERE codigo='901'")) {
        if (rows == null || !rows.Read()) throw new InvalidOperationException("The fictional record did not load.");
        Response.ContentType = "text/plain";
        Response.Write(rows.GetString(0));
    }
}
</script>
